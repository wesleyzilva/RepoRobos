{
  Robo: FORCA_SAIDA_OCO
  Descricao: Entrada por F=MA. Saida com OCO fixo (Stop + Alvo simultaneos).
             Ao entrar, envia stop e alvo ao mesmo tempo — o primeiro que bater cancela o outro.
             3 contratos. RRR configuravel.
  Versao: 1.0
  Estrategia_saida: OCO — Stop fixo + Alvo fixo (RRR 1:2 por padrao)
}

input
  // Entrada
  ForcaMinimaEntrada(55);
  VolumeMinimo(2000);
  PeriodoMediaVolume(20);
  UsarFiltroVolume(true);
  Contratos(3);
  // OCO
  StopPontos(100.0);         // distancia do stop em pontos
  AlvoPontos(200.0);         // distancia do alvo em pontos (RRR 1:2)
  StopLimitOffset(5.0);      // slippage do stop limit apos o stop
  // Horario
  StopHorario_H(17);
  StopHorario_M(45);

var
  fCorpo, fRange, fVolMedia, fMassa, fAceleracao, fForca : float;
  fForcaAbs, fEscalaCor : float;
  r, g, b : integer;
  bDeveOperar : boolean;
  fStopCompra, fAtivoCompra : float;
  fStopVenda, fAtivoVenda   : float;

begin
  // --- F = M x A ---
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;
  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;
  fMassa       := fCorpo / fRange;
  fAceleracao  := Volume / fVolMedia;
  fForca       := fMassa * fAceleracao * 100;
  if fForca >  100 then fForca :=  100;
  if fForca < -100 then fForca := -100;
  fForcaAbs := abs(fForca);

  // --- DEGRADÊ ---
  r := 128; g := 128; b := 128;
  fEscalaCor := (fForcaAbs - ForcaMinimaEntrada) / (100 - ForcaMinimaEntrada);
  if fEscalaCor < 0 then fEscalaCor := 0;
  if fEscalaCor > 1 then fEscalaCor := 1;
  fEscalaCor := fEscalaCor * fEscalaCor;
  if abs(fCorpo) < 0.1 * fRange then
  begin
    r := 255; g := 255; b := 255;
  end
  else if (fForca > 0) and (fForcaAbs >= ForcaMinimaEntrada) then
  begin
    g := 110 + Round(fEscalaCor * 145); r := 110 - Round(fEscalaCor * 110); b := 110 - Round(fEscalaCor * 110);
    if g > 255 then g := 255; if r < 0 then r := 0; if b < 0 then b := 0;
  end
  else if (fForca < 0) and (fForcaAbs >= ForcaMinimaEntrada) then
  begin
    r := 110 + Round(fEscalaCor * 145); g := 110 - Round(fEscalaCor * 110); b := 110 - Round(fEscalaCor * 110);
    if r > 255 then r := 255; if g < 0 then g := 0; if b < 0 then b := 0;
  end;
  PaintBar(RGB(r, g, b));

  // --- STOP HORÁRIO ---
  if Time() >= (StopHorario_H * 10000 + StopHorario_M * 100) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end
  else
    bDeveOperar := true;

  // --- OCO: ORDENS DE SAÍDA ATIVAS ---
  // Envia stop + alvo a cada barra enquanto em posição (Profit mantem a ultima ativa)
  if IsBought then
  begin
    fStopCompra  := BuyPrice - StopPontos * MinPriceIncrement;
    fAtivoCompra := BuyPrice + AlvoPontos * MinPriceIncrement;
    SellToCoverStop (fStopCompra,  fStopCompra  - StopLimitOffset * MinPriceIncrement, Contratos);
    SellToCoverLimit(fAtivoCompra, Contratos);
  end;

  if IsSold then
  begin
    fStopVenda  := SellPrice + StopPontos * MinPriceIncrement;
    fAtivoVenda := SellPrice - AlvoPontos * MinPriceIncrement;
    BuyToCoverStop (fStopVenda,  fStopVenda  + StopLimitOffset * MinPriceIncrement, Contratos);
    BuyToCoverLimit(fAtivoVenda, Contratos);
  end;

  // --- ENTRADA ---
  if bDeveOperar and (not IsBought) and (not IsSold) then
  begin
    if (fForca >= ForcaMinimaEntrada) and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
      BuyAtMarket(Contratos);

    if (fForca <= -ForcaMinimaEntrada) and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
      SellShortAtMarket(Contratos);
  end;

end;
