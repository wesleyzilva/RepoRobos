{
  Robo: FORCA_SAIDA_TRAILING
  Descricao: Entrada por F=MA com confirmacao multi-timeframe (Contexto+Direcao+Gatilho).
             Saida com Trailing Stop dinamico via ATR.
             O stop segue o melhor preco a uma distancia de ATR * multiplicador.
             Sem alvo fixo: deixa o movimento correr. 3 contratos.
  Versao: 3.0
  Estrategia_saida: Trailing Stop ATR — stop dinamico que acompanha o preco

  Tripleta recomendada (robo roda no TF3 = gatilho):
    60/30/15 -> roda em 15min -> iJanelaDir=2 (30min), iJanelaCtx=4 (60min)
    30/15/5  -> roda em 5min  -> iJanelaDir=3 (15min), iJanelaCtx=6 (30min)

  Configuracoes ATR por TF:
    15min: ATR_TrailMult=0.5
    30min: ATR_TrailMult=0.75
    60min: ATR_TrailMult=1.0
}

input
  // Entrada
  ForcaMinimaEntrada(55);
  VolumeMinimo(2000);
  PeriodoMediaVolume(20);
  UsarFiltroVolume(true);
  Contratos(3);
  // Trailing ATR
  PeriodoATR(14);
  ATR_TrailMult(0.5);        // distancia do trail em ATR  (15min=0.5, 30min=0.75, 60min=1.0)
  TrailOffset(5.0);          // slippage do stop limit
  // Horario
  StopHorario_H(17);
  StopHorario_M(45);
  // Multi-TF: janela de contexto e direcao (em candles do TF atual)
  iJanelaDir(2);             // direcao: 30min = 2x de 15min; 15min = 3x de 5min
  iJanelaCtx(4);             // contexto: 60min = 4x de 15min; 30min = 6x de 5min

var
  fCorpo, fRange, fVolMedia, fMassa, fAceleracao, fForca : float;
  fForcaAbs, fEscalaCor : float;
  fCorpoAnterior : float;
  r, g, b : integer;
  bDeveOperar   : boolean;
  fTrailStop    : float;
  fMelhorPreco  : float;
  fATR, fTrailDist : float;
  fMediaDir, fMediaCtx : float;
  bContextoAlta, bContextoBaixa : boolean;
  bDirecaoAlta, bDirecaoBaixa : boolean;

begin
  // --- F = M x A ---
  fCorpo := Close - Open;
  fRange := High - Low;
  if fRange <= 0 then fRange := 0.0001;
  fVolMedia := Media(PeriodoMediaVolume, Volume);
  if fVolMedia <= 0 then fVolMedia := 1;
  fMassa      := fCorpo / fRange;
  fAceleracao := Volume / fVolMedia;
  fForca      := fMassa * fAceleracao * 100;
  if fForca >  100 then fForca :=  100;
  if fForca < -100 then fForca := -100;
  fForcaAbs := abs(fForca);

  // --- Multi-TF: Contexto e Direcao ---
  fMediaDir := Media(iJanelaDir, Close);
  fMediaCtx := Media(iJanelaCtx, Close);
  bContextoAlta  := (Close > fMediaCtx) and (fMediaCtx > fMediaCtx[iJanelaCtx]);
  bContextoBaixa := (Close < fMediaCtx) and (fMediaCtx < fMediaCtx[iJanelaCtx]);
  bDirecaoAlta   := (Close > fMediaDir) and (fMediaDir > fMediaDir[iJanelaDir]);
  bDirecaoBaixa  := (Close < fMediaDir) and (fMediaDir < fMediaDir[iJanelaDir]);

  // --- ATR dinamico ---
  fATR       := ATR(PeriodoATR);
  if fATR < MinPriceIncrement then fATR := MinPriceIncrement;
  fTrailDist := fATR * ATR_TrailMult;

  // --- DEGRADÊ ---
  r := 255; g := 255; b := 255;  // branco = sem sinal
  fCorpoAnterior := Close[1] - Open[1];
  fEscalaCor := (fForcaAbs - ForcaMinimaEntrada) / (100 - ForcaMinimaEntrada);
  if fEscalaCor < 0 then fEscalaCor := 0;
  if fEscalaCor > 1 then fEscalaCor := 1;
  fEscalaCor := fEscalaCor * fEscalaCor;
  if abs(fCorpo) < 0.1 * fRange then
  begin
    r := 128; g := 128; b := 128;  // cinza = indecisao (doji)
  end
  else if (fForcaAbs >= ForcaMinimaEntrada) and (fForca * fCorpoAnterior < 0) then
  begin
    r := 255; g := 165; b := 0;    // laranja = reversao (forca contraria ao candle anterior)
  end
  else if (fForca > 0) and (fForcaAbs >= ForcaMinimaEntrada) then
  begin
    g := 110 + Round(fEscalaCor * 145); r := 110 - Round(fEscalaCor * 110); b := 110 - Round(fEscalaCor * 110);
    if g > 255 then g := 255; if r < 0 then r := 0; if b < 0 then b := 0;
  end
  else if (fForca < 0) and (fForcaAbs >= ForcaMinimaEntrada) then
  begin
    r := 110 + Round(fEscalaCor * 145); g := 110 - Round(fEscalaCor * 110); b := 110 - Round(fEscalaCor * 110);
    if r > 255 then r := 255; if g < 0 then g := 0; if b < 0 then b := 0;
  end;
  PaintBar(RGB(r, g, b));

  // --- STOP HORÁRIO ---
  if Time() >= (StopHorario_H * 10000 + StopHorario_M * 100) then
  begin
    if IsBought or IsSold then ClosePosition;
    bDeveOperar := false;
  end
  else
    bDeveOperar := true;

  // Resetar melhor preco quando nao ha posicao
  if (not IsBought) and (not IsSold) then
    fMelhorPreco := 0;

  // --- TRAILING STOP: COMPRADO ---
  if IsBought then
  begin
    if (fMelhorPreco = 0) or (High > fMelhorPreco) then
      fMelhorPreco := High;

    fTrailStop := fMelhorPreco - fTrailDist;
    if fTrailStop < BuyPrice - fTrailDist then
      fTrailStop := BuyPrice - fTrailDist;

    SellToCoverStop(fTrailStop, fTrailStop - TrailOffset * MinPriceIncrement, Contratos);
  end;

  // --- TRAILING STOP: VENDIDO ---
  if IsSold then
  begin
    if (fMelhorPreco = 0) or (Low < fMelhorPreco) then
      fMelhorPreco := Low;

    fTrailStop := fMelhorPreco + fTrailDist;
    if fTrailStop > SellPrice + fTrailDist then
      fTrailStop := SellPrice + fTrailDist;

    BuyToCoverStop(fTrailStop, fTrailStop + TrailOffset * MinPriceIncrement, Contratos);
  end;

  // --- ENTRADA (requer alinhamento: Contexto TF1 + Direcao TF2 + Gatilho TF3) ---
  if bDeveOperar and (not IsBought) and (not IsSold) then
  begin
    if (fForca >= ForcaMinimaEntrada) and bContextoAlta and bDirecaoAlta
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      BuyAtMarket(Contratos);
      fMelhorPreco := 0;
    end;

    if (fForca <= -ForcaMinimaEntrada) and bContextoBaixa and bDirecaoBaixa
      and ((not UsarFiltroVolume) or (Volume >= VolumeMinimo)) then
    begin
      SellShortAtMarket(Contratos);
      fMelhorPreco := 0;
    end;
  end;

end;
