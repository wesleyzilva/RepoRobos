var
  bBuyCondition1  : Boolean;
  bBuyCondition2  : Boolean;
  bBuyCondition3  : Boolean;
  bSellCondition1 : Boolean;
  bSellCondition2 : Boolean;
  bSellCondition3 : Boolean;
begin
  // XRay Summary:
  // This example code shows the XRay feature to provide visibility into the strategs conditions and variable states 
  // within the Automation Strategy Details panel. The variables `bBuyConditionX` and `bSellConditionX` determine 
  // whether specific buy or sell conditions are met based on market data (e.g., close prices) and position status. 
  // XRay displays these conditions in real time, and this example categorizes them into "Buy" and "Sell" groups. Each variables 
  // status, calculated value, and group are updated dynamically and color-coded (Yellow for Buy conditions, Green for Sell conditions).
  // Define the conditions for executing a BuyAtMarket order.
  // Each condition must evaluate to true for the buy action to proceed.
  bBuyCondition1 := Close[1] > Close[0]; 
  bBuyCondition2 := Close[2] > Close[1];
  bBuyCondition3 := Close[3] > Close[2];

  // Define the conditions for executing a SellAtMarket order.
  // Similar logic applies to sell actions, but the checks are inverted for downward trends.
  bSellCondition1 := Close[0] > Close[1];
  bSellCondition2 := Close[1] > Close[2];
  bSellCondition3 := Close[2] > Close[3];

  // Execute orders based on the conditions defined above.
  // Only proceed with the respective action if all conditions are met.
  if bBuyCondition1 and bBuyCondition2 and bBuyCondition3 then
    buyAtMarket
  else if bSellCondition1 and bSellCondition2 and bSellCondition3 then
    sellShortAtMarket;
  // Manage positions post-execution.
  if IsBought then
    begin
      SellToCoverLimit(buyPrice + 10*minPriceIncrement, BuyPositionQty);
      SellToCoverStop(buyPrice - 10*minPriceIncrement, BuyPrice - 10*minPriceIncrement, BuyPositionQty);
    end
  else if IsSold then
    begin
      BuyToCoverLimit(SellPrice - 10*minPriceIncrement, SellPositionQty); 
      BuyToCoverStop(SellPrice + 10*minPriceIncrement, SellPrice + 10*minPriceIncrement, SellPositionQty);
    end;
  // Configure XRay for the "Buy" group.
  // Displays variable states, calculated values, and their respective color-coded statuses.
  XRay("BuyCondition1", bBuyCondition1, "Buy", Close[1] - Close[0], clYellow);
  XRay("BuyCondition2", bBuyCondition2, "Buy", Close[2] - Close[1], clYellow);
  XRay("BuyCondition3", bBuyCondition3, "Buy", Close[3] - Close[2], clYellow);
  // Configure XRay for the "Sell" group.
  // Similar to the "Buy" group, with Green used for visual distinction.
  XRay("SellCondition1", bSellCondition1, "Sell", Close[0] - Close[1], clGreen);
  XRay("SellCondition2", bSellCondition2, "Sell", Close[1] - Close[2], clGreen);
  XRay("SellCondition3", bSellCondition3, "Sell", Close[2] - Close[3], clGreen);
end;

//para medias moveis
input
  shortPeriod(18);     // Number of periods for the short-term moving average
  longPeriod(68);      // Number of periods for the long-term moving average
var
  shortMA, longMA : Float;  // Variables to store short and long moving averages
begin
  // Calculate the moving averages using the closing price
  shortMA := SMA(shortPeriod, tvClose);   // Short-term moving average
  longMA := SMA(longPeriod, tvClose);     // Long-term moving average

  // Plot the moving averages on the chart
  plot(shortMA);      // Plot short-term MA
  plot2(longMA);      // Plot long-term MA

  // Entry strategy
  // Buy if:
  // - Not in a long position,
  // - The short MA crosses below the long MA (bearish crossover)
  if (Position <= 0) and (shortMA < longMA) and (shortMA[1] >= longMA[1]) then
    begin
      if (Position < 0) then
        ReversePosition     // If currently short, reverse to long
      else
        BuyAtMarket;        // Otherwise, open a long position at market
    end
  // Sell if:
  // - Not in a short position,
  // - The short MA crosses above the long MA (bullish crossover)
  else if (Position >= 0) and (shortMA > longMA) and (shortMA[1] <= longMA[1]) then
    begin
      if (Position > 0) then
        ReversePosition     // If currently long, reverse to short
      else
        SellShortAtMarket;  // Otherwise, open a short position at market
    end;
end

