// boiller band
input
  nPeriod(20);           // Number of periods for Bollinger Bands calculation
  fStandardDeviation(2.0);  // Standard deviation factor for upper and lower bands
var
  upperBand, lowerBand : Float;  // Variables to store upper and lower Bollinger Bands
begin
  // Calculate the upper and lower Bollinger Bands
  upperBand := BollingerBands(fStandardDeviation, nPeriod, 0)|0|;  // Upper band (index 0)
  lowerBand := BollingerBands(fStandardDeviation, nPeriod, 0)|1|;  // Lower band (index 1)

  // Plot the bands on the chart
  plot(upperBand);     // Plot the upper band
  plot2(lowerBand);    // Plot the lower band

  // Entry strategy
  // Buy if the closing price is below or equal to the lower band and not currently in a long position
  if (Position <= 0) and (Close <= lowerBand) then
    begin
      if (Position < 0) then
        ReversePosition  // If currently short, reverse to long
      else
        BuyAtMarket;     // Otherwise, open a long position at market
    end
  // Sell if the closing price is above or equal to the Upper band and not currently in a short position
  else if (Position >= 0) and (Close >= upperBand) then
    begin
      if (Position > 0) then
        ReversePosition  // If currently long, reverse to short
      else
        SellshortAtMarket;  // Otherwise, open a short position at market
    end;
end
//MACD
input
  shortPeriod(12);     // Number of periods for the short-term EMA
  longPeriod(26);      // Number of periods for the long-term EMA
  signalPeriod(9);     // Number of periods for the signal line
var
  macdLine, macdSignal : Float;  // Variables to store MACD line and Signal line

begin
  // Calculate MACD line and Signal line
  macdLine := MACD(longPeriod, shortPeriod, signalPeriod)|0|;   // MACD line (index 0)
  macdSignal := MACD(longPeriod, shortPeriod, signalPeriod)|1|; // Signal line (index 1)

  // Plot the MACD line and the signal line on the chart
  plot(macdLine);       // Plot MACD line
  plot2(macdSignal);    // Plot Signal line

  // Entry strategy
  // Buy if:
  // - Not in a long position,
  // - MACD line crosses below the signal line (bearish crossover)
  if (Position <= 0) and (macdLine < macdSignal) and (macdLine[1] >= macdSignal[1]) then
    begin
      if (Position < 0) then
        ReversePosition     // If currently short, reverse to long
      else
        BuyAtMarket;        // Otherwise, open a long position at market
    end
  // Sell if:
  // - Not in a short position,
  // - MACD line crosses above the signal line (bullish crossover)
  else if (Position >= 0) and (macdLine > macdSignal) and (macdLine[1] <= macdSignal[1]) then
    begin
      if (Position > 0) then
        ReversePosition     // If currently long, reverse to short
      else
        SellShortAtMarket;  // Otherwise, open a short position at market
    end;
end

//RSI LSI
input
  dSellThreshold(40);  // RSI value below which to trigger a buy (oversold zone)
  dBuyThreshold(60);   // RSI value above which to trigger a sell (overbought zone)
var
  rsiValue : Float;  // Variable to store the current RSI value
begin
  // Calculate RSI using 14 periods and apply it to the current bar
  rsiValue := RSI(14, 0);

  // Plot the RSI value on the chart
  plot(rsiValue);

  // Entry strategy
  // Buy if:
  // - Not in a long position,
  // - RSI is below the sell threshold (interpreted as oversold)
  if (Position <= 0) and (rsiValue < dSellThreshold) then
    begin
      if (Position < 0) then
        ReversePosition     // If currently short, reverse to long
      else
        BuyAtMarket;        // Otherwise, open a long position at market
    end
  // Sell if:
  // - Not in a short position,
  // - RSI is above the buy threshold (interpreted as overbought)
  else if (Position >= 0) and (rsiValue > dBuyThreshold) then
    begin
      if (Position > 0) then
        ReversePosition     // If currently long, reverse to short
      else
        SellShortAtMarket;  // Otherwise, open a short position at market
    end;
end
//SlowStochastic
input
  nPeriod(18);         // Lookback period for the stochastic calculation
  nLimitBuy(30);       // Threshold below which to buy (typically oversold zone)
  nLimitSell(60);      // Threshold above which to sell (typically overbought zone)

// Variable declaration
var
  slowK, fastK : Float;   // Variables for the slow and fast stochastic values

begin
  // Calculate slow and fast stochastic values
  slowK := SlowStochastic(nPeriod, 9, 0);   // Slow stochastic using %K with smoothing
  fastK := FastStochastic(nPeriod, 3, 0);   // Fast stochastic using %K with shorter smoothing

  // Plot stochastic values on the chart
  plot(slowK);     // Plot slow stochastic
  plot2(fastK);    // Plot fast stochastic

  // Entry strategy
  // Buy if:
  // - Not in a long position,
  // - Slow stochastic is below the buy threshold (potential oversold signal)
  if (Position <= 0) and (slowK < nLimitBuy) then
    begin
      if (Position < 0) then
        ReversePosition     // If currently short, reverse to long
      else
        BuyAtMarket;        // Otherwise, open a long position at market
    end
  // Sell if:
  // - Not in a short position,
  // - Fast stochastic is above the sell threshold (potential overbought signal)
  else if (Position >= 0) and (fastK > nLimitSell) then
    begin
      if (Position > 0) then
        ReversePosition     // If currently long, reverse to short
      else
        SellShortAtMarket;  // Otherwise, open a short position at market
    end;
end
