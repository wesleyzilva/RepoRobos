  // â”€â”€ VWAP DIÃRIO acumulado (preÃ§o tÃ­pico ponderado por volume) â”€
  fVWAPSoma  := fVWAPSoma + ((High + Low + Close) / 3.0) * Volume;
  fVWAPVol   := fVWAPVol  + Volume;
  if fVWAPVol > 0 then
    fVWAPDiario := fVWAPSoma / fVWAPVol;

  // â”€â”€ INDICADORES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  fMME200   := Media(PeriodoMME200, Close);
  fMediaVol := Media(PeriodoMediaVol, Volume);

  // â”€â”€ LIMITES DE RISCO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  fLimiteDia    := SaldoConta * (RiscoDiaPct    / 100.0);
  fLimiteSemana := SaldoConta * (RiscoSemanaPct / 100.0);


  // â”€â”€ TRACKING DE RESULTADO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if bEstavaPosicionado and (not IsBought) and (not IsSold) then
  begin
    fResultadoPontos  := (Close - fPrecoEntrada) * iDirecaoPosicao;
    fResultadoReais   := fResultadoPontos * ValorPorPonto;
    fResultadoDia     := fResultadoDia    + fResultadoReais;
    fResultadoSemana  := fResultadoSemana + fResultadoReais;
  end;

  if UsarGestaoRisco then
  begin
    if (fResultadoDia    <= -fLimiteDia)    then bBloqueioDia    := true;
    if (fResultadoSemana <= -fLimiteSemana) then bBloqueioSemana := true;
    if UsarHardLock and (bBloqueioDia or bBloqueioSemana) and (IsBought or IsSold) then
      ClosePosition;
  end;

  // â”€â”€ CAPTURA DO 1o CANDLE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if iCandleDia = 1 then
  begin
    fMaxC1   := High;
    fMinC1   := Low;
    fAberDia := Open;
    fFechC1  := Close;
    fRangeC1 := High - Low;
    fCorpoC1 := Abs(Close - Open);
    fVolC1   := Volume;
  end;

  { â”€â”€ LÃ“GICA DE SINAL (apenas no 2Âº candle em diante) â”€â”€ }
  if (iCandleDia = 2) and (not bEntradaExecutada) and (fRangeC1 > 0)
     and (not IsBought) and (not IsSold)
     and (not (UsarGestaoRisco and (bBloqueioDia or bBloqueioSemana))) then
  begin
    bGapExtCima    := fAberDia > High[2];
    bCorpoAlta     := (fFechC1 > fAberDia) and (fCorpoC1 >= fRangeC1 * PctCorpoMinimo);
    bVolClimatico  := (fMediaVol > 0) and (fVolC1 >= fMediaVol * FatorVolumeClimatico);
    bAcimaMME200   := (not UsarFiltroMME200) or (Close > fMME200);
    bSinalCompra   := bGapExtCima and bCorpoAlta and bVolClimatico and bAcimaMME200
                      and (fFechC1 > fVWAPDiario);

    if bSinalCompra then
    begin
      fStopAtual  := fMinC1;
      fAlvoAtual  := fMaxC1 + (fRangeC1 * MultiplicadorAlvo);
      BuyAtMarket;
      bEntradaExecutada := true;
    end;
  end;

  // â”€â”€ GESTÃƒO DE POSIÃ‡ÃƒO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if IsBought or IsSold then
    iBarrasEmPosicao := iBarrasEmPosicao + 1
  else
  begin
    iBarrasEmPosicao := 0;
    bBreakEvenAtivo  := false;
  end;

  if IsBought and bEstavaPosicionado then
  begin
    if UsarBreakEven and (not bBreakEvenAtivo) and ((High - fPrecoEntrada) >= BreakEvenTriggerPontos) then
      bBreakEvenAtivo := true;

    if UsarBreakEven and bBreakEvenAtivo then
      fStopAtual := Max(fStopAtual, fPrecoEntrada + BreakEvenOffsetPontos);

    if UsarOCO and ((Low <= fStopAtual) or (High >= fAlvoAtual)) then
      ClosePosition
    else if iBarrasEmPosicao >= MaxBarrasPosicao then
      ClosePosition;
  end;

  // â”€â”€ REGISTRO DE ENTRADA â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if (not bEstavaPosicionado) and IsBought then
  begin
    fPrecoEntrada    := Close;
    iDirecaoPosicao  := 1;
    iBarrasEmPosicao := 0;
    bBreakEvenAtivo  := false;
    fStopAtual       := fMinC1;
    fAlvoAtual       := fMaxC1 + (fRangeC1 * MultiplicadorAlvo);
  end;

  bEstavaPosicionado := IsBought or IsSold;
end;
