    iBarrasEmPosicao := 0;
    bBreakEvenAtivo  := false;
    fStopAtual       := fMinC1;
    fAlvoAtual       := fMaxC1 + (fRangeC1 * MultiplicadorAlvo);
  end;

  bEstavaPosicionado := IsBought or IsSold;
