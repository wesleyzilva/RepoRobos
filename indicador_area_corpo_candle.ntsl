// Exemplo NTFL/NTSL: Desenha área de operação baseada no corpo do candle
{
  Indicador: AreaOperacaoCorpoCandle
  Descricao: Desenha retângulo a partir da abertura e fechamento do candle
  Versao: 1.0
}

input
  FatorArea(1.5); // Multiplicador do corpo do candle
  CorArea(RGB(0, 128, 255)); // Azul
  ExtensaoDireita(20); // Quantos candles para a direita

var
  vAbertura, vFechamento, vCorpo, vCentro, vAltura: float;
  vY1, vY2: float;
  i: integer;

begin
  // Calcula corpo do candle
  vAbertura := Open;
  vFechamento := Close;
  vCorpo := abs(vFechamento - vAbertura);
  vAltura := vCorpo * FatorArea;
  vCentro := (vAbertura + vFechamento) / 2;
  vY1 := vCentro + (vAltura / 2);
  vY2 := vCentro - (vAltura / 2);

  // Desenha o retângulo para a direita
  for i := 0 to ExtensaoDireita do
  begin
    DrawBox(i, vY1, i+1, vY2, CorArea, 30, false);
  end;
end;